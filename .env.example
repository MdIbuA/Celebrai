# CelebrAI — server-side configuration for live AI mode.
# Copy to .env and fill in. .env is gitignored and must never be committed.
# The browser never sees any of these values.

# Which provider the proxy calls: "anthropic" or "openai"
AI_PROVIDER=anthropic

# Exactly one key, matching the provider above.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional model override.
# AI_MODEL=claude-sonnet-4-5

# Port for the local server.
PORT=4173
